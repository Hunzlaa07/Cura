em\", \"label\": \"Item\", \"type\": \"text\"}, {\"key\": \"status\", \"label\": \"Status\", \"type\": \"text\"}, {\"key\": \"impact\", \"label\": \"Impact Level\", \"type\": \"select\", \"options\": [\"Critical\", \"High\", \"Medium\", \"Low\"]}, {\"key\": \"notes\", \"label\": \"Details\", \"type\": \"text\"} ], \"rows\": [ {\"item\": \"System","length":10408}
