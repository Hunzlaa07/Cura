table\", \"↓ Declining\"]} ], \"rows\": [ {\"metric_name\": \"Example metric 1\", \"current_value\": \"45\", \"target_value\": \"60\", \"variance\": \"-25%\", \"trend\": \"↓ Declining\"}, {\"metric_name\": \"Example metric 2\", \"current_value\": \"8.2/10\", \"target_value\": \"9.0\", \"variance\": \"-8.9%\", \"trend\": \"↑ Improving\"}, {\"metric_name\": \"Example metric 3\", \"current_value\": \"$125K\", \"target_value\": \"$150K\", \"variance\": \"-16.7%\", \"trend\": \"→ Stable\"} ] }, { \"table_id\": \"scenario_data\", \"title\": \"Situation/Context Data\", \"description\": \"Contextual information relevant to the scenario\", \"columns\": [ {\"key\": \"item\", \"label\": \"Item\", \"type\": \"text\"}, {\"key\": \"status\", \"label\": \"Status\", \"type\": \"text\"}, {\"key\": \"impact\", \"label\": \"Impact Level\", \"type\": \"select\", \"options\": [\"Critical\", \"High\", \"Medium\", \"Low\"]}, {\"key\": \"notes\", \"label\": \"Details\", \"type\": \"text\"} ], \"rows\": [ {\"item\": \"Challenge/Resource 1\", \"status\": \"Active\", \"impact\": \"High\", \"notes\": \"Description of impact\"}, {\"item\": \"Challenge/Resource 2\", \"status\": \"Pending\", \"impact\": \"Critical\", \"notes\": \"Description of impact\"} ] }, { \"table_id\": \"resources_constraints\", \"title\": \"Available Resources & Constraints\", \"description\": \"What you have to work with and limitations\", \"columns\": [ {\"key\": \"resource_type\", \"label\": \"Resource Type\", \"type\": \"text\"}, {\"key\": \"availability\", \"label\": \"Availability\", \"type\": \"text\"}, {\"key\": \"cost_or_effort\", \"label\": \"Cost/Effort\", \"type\": \"text\"}, {\"key\": \"constraint\", \"label\": \"Constraint\", \"type\": \"text\"} ], \"rows\": [ {\"resource_type\": \"Resource 1\", \"availability\": \"Fully available\", \"cost_or_effort\": \"Included\", \"constraint\": \"Time-bound\"}, {\"resource_type\": \"Resource 2\", \"availability\": \"Limited\", \"cost_or_effort\": \"Additional budget needed\", \"constraint\": \"Capacity limited\"} ] } ] }, \"ar\": { \"description\": \"Arabic translation of BACKGROUND SECTION only\", \"instructions\": \"Arabic translation of ROLE & SCENARIO SECTION only\", \"questions\": [\"السؤال 1 محدد لهذا السيناريو\", \"السؤال 2 محدد لهذا السيناريو\", \"السؤال 3 محدد لهذا السيناريو\", \"السؤال 4 محدد لهذا السيناريو\", \"السؤال 5 محدد لهذا السيناريو\", \"السؤال 6 محدد لهذا السيناريو\", \"السؤال 7 محدد لهذا السيناريو\"], \"tables\": [{\"table_id\": \"primary_metrics\", \"title\": \"المقاييس الحالية والأداء\", \"columns\": [], \"rows\": []}] }, \"duration_minutes\": 60 \"case_study_type\": \"analytical\", \"difficulty_level\": \"7\", \"num_questions\": 600-900, \"content_length\": \"\", \"variant_number\": 3, \"variant_focus\": \"problem_solving\", \"job_title\": \"Senior Database Engineer: HA/DR & Cloud Solutions\", \"industry\": \"tech\", \"seniority_level\": \"senior\", \"document_context_used\": true } ===== CRITICAL REQUIREMENTS FOR QUESTIONS ===== ✓ EACH QUESTION MUST BE UNIQUE TO THIS SPECIFIC SCENARIO ✓ NO TEMPLATE LANGUAGE OR PLACEHOLDER TEXT ✓ REFERENCE SPECIFIC METRICS/NUMBERS FROM THE DESCRIPTION ✓ BUILD ON SCENARIO CONTEXT - NOT GENERIC ✓ EACH QUESTION MUST BE 2-4 DETAILED SENTENCES ✓ NO DIFFICULTY LEVEL INDICATORS IN QUESTION TEXT ✓ QUESTIONS SHOULD BUILD IN DEPTH/COMPLEXITY ✓ VARIANT FOCUS IS EMBEDDED IN QUESTION DESIGN ===== VALIDATION CHECKLIST ===== ✓ Description starts with company name and what they do ✓ Description builds: Company → Scale → Expertise → Challenge ✓ NO role assignment in description section ✓ Instructions starts with \"As the Senior Database Engineer: HA/DR & Cloud Solutions...\" ✓ All content is specific to Senior Database Engineer: HA/DR & Cloud Solutions role ✓ Industry terminology used: tech ✓ Appropriate seniority level: senior ✓ 600-900 specific questions included ✓ All questions reference specific scenario details ✓ Tables have realistic, industry-appropriate data ✓ Variant 3 focus embedded