y limited\"} FALLBACK CONTEXT: === COMPANY BACKGROUND === { \"en\": { \"company\": { \"name\": \"NXT LABS\", \"industry\": \"Technology\", \"foundedYear\": null, \"scale\": { \"employees\": null, \"offices\": [\"Rawalpindi, Pakistan\"], \"countries\": [\"Pakistan\"] }, \"expertise\": { \"specializations\": [\"High availability\", \"Disaster recovery\", \"Cloud solutions\"], \"mainProductsServices\": [\"Database systems management\", \"Disaster recovery solutions\", \"Cloud databases on AWS and Azure\"] }, \"missionStatement\": null, \"coreValues\": null, \"culture\": \"Dynamic work environment with ample opportunities for professional growth\", \"marketPosition\": \"Leading technology firm\" } }, \"ar\": { \"company\": { \"name\": \"NXT LABS\", \"industry\": \"التكنولوجيا\", \"foundedYear\": null, \"scale\": { \"employees\": null, \"offices\": [\"روالبندي، باكستان\"], \"countries\": [\"باكستان\"] }, \"expertise\": { \"specializations\": [\"التوافر العالي\", \"استعادة الكوارث\", \"حلول السحابة\"], \"mainProductsServices\": [\"إدارة أنظمة قواعد البيانات\", \"حلول استعادة الكوارث\", \"قواعد البيانات السحابية على AWS و Azure\"] }, \"missionStatement\": null, \"coreValues\": null, \"culture\": \"بيئة عمل ديناميكية مع فرص كبيرة للنمو المهني\", \"marketPosition\": \"شركة رائدة في مجال التكنولوجيا\" } } } === END COMPANY BACKGROUND === TASK: Generate 5 multiple choice questions to assess candidates for this role. REQUIREMENTS: - Difficulty Level: MEDIUM - Each question must have exactly 4 options (A, B, C, D) - Only ONE correct answer per question - Questions should be relevant to the job role - Include mix of knowledge, scenario, and application questions - Provide clear explanation for the correct answer Return ONLY valid JSON with NO markdown, NO explanations: { \"questions\": [ { \"question_en\": \"English question text\", \"question_ar\": \"نص السؤال بالعربية\", \"options\": [ { \"id\": \"A\", \"text_en\": \"Option A in English\", \"text_ar\": \"الخيار أ بالعربية\", \"is_correct\": false }, { \"id\": \"B\", \"text_en\": \"Option B in English\", \"text_ar\": \"الخيار ب بالعربية\", \"is_correct\": true }, { \"id\": \"C\", \"text_en\": \"Option C in English\", \"text_ar\": \"الخيار ج بالعربية\", \"is_correct\": false }, { \"id\": \"D\", \"text_en\": \"Option D in English\", \"text_ar\": \"الخيار د بالعربية\", \"is_correct\": false } ], \"explanation_en\": \"Explanation why B is correct\", \"explanation_ar\": \"شرح لماذا ب هو الصحيح\", \"difficulty\": \"medium\", \"category\": \"technical/behavioral/analytical\" } ] }"}
