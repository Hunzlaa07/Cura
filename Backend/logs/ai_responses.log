 MySQL و PostgreSQL على AWS و Azure، وضمان أمان وسلامة البيانات، وتحسين أداء قواعد البيانات وسط تراكم الديون التقنية واحتياجات توسع البنية التحتية. هذه القضايا حاسمة حيث تؤثر مباشرة على رضا العملاء ومكانة الشركة في السوق.\", \"instructions\": \"بصفتك مهندس قواعد بيانات أول: حلول HA/DR والسحابة في NXT LABS، يتم تكليفك بتثبيت وتحسين بنية قواعد البيانات في الشركة. تشمل أهدافك المحددة تقليل وقت استجابة الحوادث، وتحسين توافر النظام، وتعزيز أداء قواعد البيانات أثناء إدارة الديون التقنية. سيتم قياس النجاح بتحقيق مقاييس الأهداف، مثل توافر النظام بنسبة 99.9٪ وتقليل وقت استجابة الحوادث إلى أقل من 10 دقائق. لديك إمكانية الوصول إلى موارد AWS و Azure، ولكنك تواجه قيودًا مثل حدود الميزانية والحاجة إلى النشر السريع. يتوقع أصحاب المصلحة حلولًا في الوقت المناسب لا تساوم على سلامة أو أمان البيانات. من المتوقع أن تقدم خطة شاملة في غضون 30 يومًا تتضمن إجراءات فورية واستراتيجية طويلة المدى لتوسيع البنية التحتية.\", \"questions\": [ \"كيف ستقوم بتحديد أولويات معالجة الديون التقنية مع ضمان الحد الأدنى من التعطيل لعمليات قواعد البيانات الحالية؟\", \"ما هي الاستراتيجيات المحددة التي ستنفذها لتحسين وقت استجابة الحوادث، وكيف ستقيس فعاليتها؟\", \"نظرًا لقيود الميزانية والوقت، كيف ستقوم بتحسين أداء قاعدة البيانات على منصات AWS و Azure؟\", \"ما هي الإجراءات التي ستتخذها لضمان أمان وسلامة البيانات أثناء عملية التحسين؟\", \"كيف ستتعاون مع فريق التطوير لمواءمة متطلبات قواعد البيانات مع الأهداف التجارية؟\", \"مع الأخذ في الاعتبار الضغط الحالي على النظام، ما هي حلول توسع البنية التحتية التي ستقترحها لتحسين موثوقية النظام؟\", \"كيف ستقوم بتوصيل التقدم والتحديات إلى أصحاب المصلحة لإدارة التوقعات بفعالية؟\" ], \"tables\": [ { \"table_id\": \"primary_metrics\", \"title\": \"المقاييس الحالية والأداء\", \"description\": \"المؤشرات الرئيسية للأداء لدور مهندس قواعد بيانات أول: حلول HA/DR والسحابة\", \"columns\": [ {\"key\": \"metric_name\", \"label\": \"المقياس\", \"type\": \"text\"}, {\"key\": \"current_value\", \"label\": \"القيمة الحالية\", \"type\": \"text\"}, {\"key\": \"target_value\", \"label\": \"الهدف\", \"type\": \"text\"}, {\"key\": \"variance\", \"label\": \"التباين\", \"type\": \"text\"}, {\"key\": \"trend\", \"label\": \"الاتجاه\", \"type\": \"select\", \"options\": [\"↑ في تحسن\", \"→ ثابت\", \"↓ في تراجع\"]} ], \"rows\": [ {\"metric_name\": \"توافر النظام\", \"current_value\": \"98%\", \"target_value\": \"99.9%\", \"variance\": \"-1.9%\", \"trend\": \"↓ في تراجع\"}, {\"metric_name\": \"وقت استجابة الحوادث\", \"current_value\": \"20 دقيقة\", \"target_value\": \"10 دقائق\", \"variance\": \"+10 دقائق\", \"trend\": \"↓ في تراجع\"}, {\"metric_name\": \"أداء قاعدة البيانات\", \"current_value\": \"7/10\", \"target_value\": \"9/10\", \"variance\": \"-2\", \"trend\": \"→ ثابت\"} ] }, { \"table_id\": \"scenario_data\", \"title\": \"بيانات السياق/الوضع\", \"description\": \"معلومات سياقية ذات صلة بالسيناريو\", \"columns\": [ {\"key\": \"item\", \"label\": \"البند\", \"type\": \"text\"}, {\"key\": \"status\", \"label\": \"الحالة\", \"type\": \"text\"}, {\"key\": \"impact\", \"label\": \"مستوى التأثير\", \"type\": \"select\", \"options\": [\"حرج\", \"عالي\", \"متوسط\", \"منخفض\"]}, {\"key\": \"notes\", \"label\": \"تفاصيل\", \"type\": \"text\"} ], \"rows\": [ {\"item\": \"إدارة قواعد البيانات السحابية\", \"status\": \"نشط\", \"impact\": \"عالي\", \"notes\": \"يتطلب تحسين الأداء الفوري\"}, {\"item\": \"أمان البيانات\", \"status\": \"قيد الانتظار\", \"impact\": \"حرج\", \"notes\": \"يحتاج إلى مراجعة شاملة وتحسين\"} ] }, { \"table_id\": \"resources_constraints\", \"title\": \"الموارد المتاحة والقيود\", \"description\": \"ما لديك للعمل به والقيود\", \"columns\": [ {\"key\": \"resource_type\", \"label\": \"نوع المورد\", \"type\": \"text\"}, {\"key\": \"availability\", \"label\": \"التوافر\", \"type\": \"text\"}, {\"key\": \"cost_or_effort\", \"label\": \"التكلفة/الجهد\", \"type\": \"text\"}, {\"key\": \"constraint\", \"label\": \"القيود\", \"type\": \"text\"} ], \"rows\": [ {\"resource_type\": \"البنية التحتية السحابية\", \"availability\": \"متاح بالكامل\", \"cost_or_effort\": \"مضمنة\", \"constraint\": \"مقيدة بالوقت\"}, {\"resource_type\": \"فريق التطوير\", \"availability\": \"محدود\", \"cost_or_effort\": \"يحتاج إلى ميزانية إضافية\", \"constraint\": \"قدرة محدودة\"} ] } ] }, \"duration_minutes\": 60, \"case_study_type\": \"analytical\", \"difficulty_level\": \"medium\", \"num_questions\": 1, \"content_length\": \"300-500\", \"variant_number\": 1, \"variant_focus\": \"operational_challenge\", \"job_title\": \"Senior Database Engineer: HA/DR & Cloud Solutions\", \"industry\": \"tech\", \"seniority_level\": \"senior\", \"document_context_used\": true }"}
