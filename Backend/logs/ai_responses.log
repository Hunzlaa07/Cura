{"provider":"openai","timestamp":1766470085265,"length":11089,"response":"{ \"en\": { \"description\": \"Acme Tech is a leading technology company that specializes in developing scalable backend solutions for enterprise-level clients. Founded in 2010, Acme Tech has grown to become a key player in the tech industry by delivering high-quality software solutions. With offices in San Francisco, London, and Tokyo, the company employs over 500 professionals and continues to expand its global presence. Acme Tech is renowned for its expertise in cloud computing and its commitment to innovation and excellence. The company fosters a culture of collaboration, agility, and continuous improvement, aligning with its mission to empower businesses through technology. However, Acme Tech recently faced an operational challenge as its backend systems struggled with increased demand, leading to performance degradation and occasional system outages. Key metrics such as system availability dropped to 95%, and incident response times increased, affecting overall client satisfaction. The challenge for the Senior Backend Engineer role is to design robust backend services that ensure high availability and mentor the team to improve system reliability and performance metrics.\", \"instructions\": \"As the Senior Backend Engineer at Acme Tech, you are tasked with leading the design of scalable backend services that address the current operational challenges. Your objectives include improving system availability to 99.9%, reducing incident response times by 20%, and mentoring junior engineers to enhance team velocity and code quality. Success will be measured by improved performance metrics such as system uptime and developer productivity. You are constrained by a limited budget and need to prioritize initiatives that offer the most significant impact. Utilize existing resources such as the CI/CD pipeline and cloud infrastructure effectively. Stakeholders expect a detailed plan within two weeks and initial improvements within the next quarter.\", \"questions\": [ \"Given the current system availability of 95%, what strategies would you implement to achieve a target of 99.9% availability?\", \"How would you address the increased incident response times and ensure faster resolution of system outages?\", \"What steps would you take to mentor junior engineers in improving code quality and contributing to overall team velocity?\", \"Considering the limited budget, how would you prioritize initiatives to enhance system reliability and performance?\", \"What specific tools or frameworks would you leverage to optimize the CI/CD pipeline and support infrastructure scaling?\", \"How would you measure the success of your initiatives in terms of developer productivity and system performance metrics?\", \"In the context of team collaboration, how would you foster a culture of continuous improvement and agile practices?\" ], \"tables\": [ { \"table_id\": \"primary_metrics\", \"title\": \"Current Metrics & Performance\", \"description\": \"Key performance indicators for Senior Backend Engineer role\", \"columns\": [ {\"key\": \"metric_name\", \"label\": \"Metric\", \"type\": \"text\"}, {\"key\": \"current_value\", \"label\": \"Current Value\", \"type\": \"text\"}, {\"key\": \"target_value\", \"label\": \"Target\", \"type\": \"text\"}, {\"key\": \"variance\", \"label\": \"Variance\", \"type\": \"text\"}, {\"key\": \"trend\", \"label\": \"Trend\", \"type\": \"select\", \"options\": [\"↑ Improving\", \"→ Stable\", \"↓ Declining\"]} ], \"rows\": [ {\"metric_name\": \"System Availability\", \"current_value\": \"95%\", \"target_value\": \"99.9%\", \"variance\": \"-4.9%\", \"trend\": \"↓ Declining\"}, {\"metric_name\": \"Incident Response Time\", \"current_value\": \"45 minutes\", \"target_value\": \"36 minutes\", \"variance\": \"20%\", \"trend\": \"→ Stable\"}, {\"metric_name\": \"Developer Productivity\", \"current_value\": \"80 velocity points\", \"target_value\": \"100 velocity points\", \"variance\": \"-20%\", \"trend\": \"↑ Improving\"} ] }, { \"table_id\": \"scenario_data\", \"title\": \"Situation/Context Data\", \"description\": \"Contextual information relevant to the scenario\", \"columns\": [ {\"key\": \"item\", \"label\": \"Item\", \"type\": \"text\"}, {\"key\": \"status\", \"label\": \"Status\", \"type\": \"text\"}, {\"key\": \"impact\", \"label\": \"Impact Level\", \"type\": \"select\", \"options\": [\"Critical\", \"High\", \"Medium\", \"Low\"]}, {\"key\": \"notes\", \"label\": \"Details\", \"type\": \"text\"} ], \"rows\": [ {\"item\": \"Backend System Performance\", \"status\": \"Active\", \"impact\": \"High\", \"notes\": \"Performance degradation observed under high load\"}, {\"item\": \"Incident Management Process\", \"status\": \"Pending\", \"impact\": \"Critical\", \"notes\": \"Delayed response times affecting client satisfaction\"} ] }, { \"table_id\": \"resources_constraints\", \"title\": \"Available Resources & Constraints\", \"description\": \"What you have to work with and limitations\", \"columns\": [ {\"key\": \"resource_type\", \"label\": \"Resource Type\", \"type\": \"text\"}, {\"key\": \"availability\", \"label\": \"Availability\", \"type\": \"text\"}, {\"key\": \"cost_or_effort\", \"label\": \"Cost/Effort\", \"type\": \"text\"}, {\"key\": \"constraint\", \"label\": \"Constraint\", \"type\": \"text\"} ], \"rows\": [ {\"resource_type\": \"Cloud Infrastructure\", \"availability\": \"Fully available\", \"cost_or_effort\": \"Included\", \"constraint\": \"Time-bound\"}, {\"resource_type\": \"Development Team\", \"availability\": \"Limited\", \"cost_or_effort\": \"Additional budget needed\", \"constraint\": \"Capacity limited\"} ] } ] }, \"ar\": { \"description\": \"شركة أكمي للتكنولوجيا هي شركة رائدة في صناعة التكنولوجيا متخصصة في تطوير حلول الواجهة الخلفية القابلة للتطوير للعملاء على مستوى المؤسسات. تأسست في عام 2010، ونمت لتصبح لاعبًا رئيسيًا في صناعة التكنولوجيا من خلال تقديم حلول برمجية عالية الجودة. مع وجود مكاتب في سان فرانسيسكو ولندن وطوكيو، توظف الشركة أكثر من 500 محترف وتواصل توسيع حضورها العالمي. تشتهر أكمي للتكنولوجيا بخبرتها في الحوسبة السحابية والتزامها بالابتكار والتميز. تعزز الشركة ثقافة التعاون والمرونة والتحسين المستمر، بما يتماشى مع مهمتها لتمكين الأعمال من خلال التكنولوجيا. ومع ذلك، واجهت أكمي للتكنولوجيا مؤخرًا تحديًا تشغيليًا حيث عانت أنظمة الواجهة الخلفية من زيادة الطلب، مما أدى إلى تدهور الأداء وانقطاع النظام العرضي. انخفضت المقاييس الرئيسية مثل توفر النظام إلى 95% وزادت أوقات الاستجابة للحوادث، مما أثر على رضا العملاء بشكل عام. التحدي لدور مهندس الواجهة الخلفية الأول هو تصميم خدمات خلفية قوية تضمن توفرًا عاليًا وتوجيه الفريق لتحسين موثوقية النظام ومقاييس الأداء.\", \"instructions\": \"بصفتك مهندس الواجهة الخلفية الأول في شركة أكمي للتكنولوجيا، فإنك مكلف بقيادة تصميم خدمات خلفية قابلة للتطوير لمواجهة التحديات التشغيلية الحالية. تشمل أهدافك تحسين توفر النظام إلى 99.9%، وتقليل أوقات الاستجابة للحوادث بنسبة 20%، وتوجيه المهندسين الشباب لتحسين سرعة الفريق وجودة الكود. سيتم قياس النجاح من خلال تحسين مقاييس الأداء مثل وقت تشغيل النظام وإنتاجية المطورين. لديك ميزانية محدودة وتحتاج إلى إعطاء الأولوية للمبادرات التي تقدم التأثير الأكبر. استخدم الموارد الحالية مثل خط أنابيب CI/CD والبنية التحتية السحابية بشكل فعال. يتوقع أصحاب المصلحة خطة تفصيلية في غضون أسبوعين وتحسينات أولية في الربع القادم.\", \"questions\": [ \"بالنظر إلى توفر النظام الحالي بنسبة 95%، ما هي الاستراتيجيات التي ستقوم بتنفيذها لتحقيق هدف 99.9%؟\", \"كيف ستعالج زيادة أوقات الاستجابة للحوادث وتضمن حلاً أسرع لانقطاعات النظام؟\", \"ما هي الخطوات التي ستتخذها لتوجيه المهندسين الشباب في تحسين جودة الكود والمساهمة في سرعة الفريق الإجمالية؟\", \"بالنظر إلى الميزانية المحدودة، كيف ستعطي الأولوية للمبادرات لتحسين موثوقية النظام والأداء؟\", \"ما هي الأدوات أو الأطر المحددة التي ستستفيد منها لتحسين خط أنابيب CI/CD ودعم توسيع البنية التحتية؟\", \"كيف ستقيس نجاح مبادراتك من حيث إنتاجية المطور ومقاييس أداء النظام؟\", \"في سياق التعاون الفريق، كيف ستعزز ثقافة التحسين المستمر والممارسات المرنة؟\" ], \"tables\": [ { \"table_id\": \"primary_metrics\", \"title\": \"المقاييس الحالية والأداء\", \"description\": \"مؤشرات الأداء الرئيسية لدور مهندس الواجهة الخلفية الأول\", \"columns\": [ {\"key\": \"metric_name\", \"label\": \"المقياس\", \"type\": \"text\"}, {\"key\": \"current_value\", \"label\": \"القيمة الحالية\", \"type\": \"text\"}, {\"key\": \"target_value\", \"label\": \"الهدف\", \"type\": \"text\"}, {\"key\": \"variance\", \"label\": \"الفرق\", \"type\": \"text\"}, {\"key\": \"trend\", \"label\": \"الاتجاه\", \"type\": \"select\", \"options\": [\"↑ تحسن\", \"→ مستقر\", \"↓ تراجع\"]} ], \"rows\": [ {\"metric_name\": \"توفر النظام\", \"current_value\": \"95%\", \"target_value\": \"99.9%\", \"variance\": \"-4.9%\", \"trend\": \"↓ تراجع\"}, {\"metric_name\": \"وقت استجابة الحوادث\", \"current_value\": \"45 دقيقة\", \"target_value\": \"36 دقيقة\", \"variance\": \"20%\", \"trend\": \"→ مستقر\"}, {\"metric_name\": \"إنتاجية المطور\", \"current_value\": \"80 نقطة سرعة\", \"target_value\": \"100 نقطة سرعة\", \"variance\": \"-20%\", \"trend\": \"↑ تحسن\"} ] }, { \"table_id\": \"scenario_data\", \"title\": \"بيانات السياق/الوضع\", \"description\": \"معلومات سياقية ذات صلة بالسيناريو\", \"columns\": [ {\"key\": \"item\", \"label\": \"العنصر\", \"type\": \"text\"}, {\"key\": \"status\", \"label\": \"الحالة\", \"type\": \"text\"}, {\"key\": \"impact\", \"label\": \"مستوى التأثير\", \"type\": \"select\", \"options\": [\"حرج\", \"عالي\", \"متوسط\", \"منخفض\"]}, {\"key\": \"notes\", \"label\": \"التفاصيل\", \"type\": \"text\"} ], \"rows\": [ {\"item\": \"أداء نظام الواجهة الخلفية\", \"status\": \"نشط\", \"impact\": \"عالي\", \"notes\": \"تدهور الأداء تحت الحمل العالي\"}, {\"item\": \"عملية إدارة الحوادث\", \"status\": \"معلق\", \"impact\": \"حرج\", \"notes\": \"تأخر أوقات الاستجابة يؤثر على رضا العملاء\"} ] }, { \"table_id\": \"resources_constraints\", \"title\": \"الموارد والقيود المتاحة\", \"description\": \"ما لديك للعمل به والقيود\", \"columns\": [ {\"key\": \"resource_type\", \"label\": \"نوع المورد\", \"type\": \"text\"}, {\"key\": \"availability\", \"label\": \"التوافر\", \"type\": \"text\"}, {\"key\": \"cost_or_effort\", \"label\": \"التكلفة/الجهد\", \"type\": \"text\"}, {\"key\": \"constraint\", \"label\": \"القيد\", \"type\": \"text\"} ], \"rows\": [ {\"resource_type\": \"البنية التحتية السحابية\", \"availability\": \"متوفر بالكامل\", \"cost_or_effort\": \"متضمن\", \"constraint\": \"مقيد بالوقت\"}, {\"resource_type\": \"فريق التطوير\", \"availability\": \"محدود\", \"cost_or_effort\": \"حاجة إلى ميزانية إضافية\", \"constraint\": \"محدود السعة\"} ] } ] }, \"duration_minutes\": 120, \"case_study_type\": \"case_study\", \"difficulty_level\": \"medium\", \"num_questions\": 7, \"content_length\": \"800\", \"variant_number\": 1, \"variant_focus\": \"operational_challenge\", \"job_title\": \"Senior Backend Engineer\""}
{"provider":"openai","timestamp":1766470133233,"length":1774,"response":"{ \"en\": { \"company_overview\": { \"name\": \"NXT LABS\", \"what_they_do\": \"technology firm\", \"founded_year\": null }, \"company_scale\": { \"offices\": \"Rawalpindi, Pakistan\", \"team_size\": null, \"global_presence\": null }, \"expertise_and_core_business\": { \"expertise_specializations\": [ \"high availability\", \"disaster recovery\", \"cloud solutions\" ], \"main_products_services\": [ \"managing and optimizing database systems\", \"implementing robust disaster recovery solutions\", \"managing cloud databases on AWS and Azure\" ] }, \"company_culture_mission_values\": { \"mission_statement\": null, \"core_values\": null, \"company_culture\": \"dynamic work environment with ample opportunities for professional growth\", \"market_position_achievements\": \"leading technology firm\" } }, \"ar\": { \"company_overview\": { \"name\": \"NXT LABS\", \"what_they_do\": \"شركة تكنولوجيا\", \"founded_year\": null }, \"company_scale\": { \"offices\": \"راولبندي، باكستان\", \"team_size\": null, \"global_presence\": null }, \"expertise_and_core_business\": { \"expertise_specializations\": [ \"التوافر العالي\", \"استعادة الكوارث\", \"حلول السحابة\" ], \"main_products_services\": [ \"إدارة وتحسين أنظمة قواعد البيانات\", \"تنفيذ حلول استعادة الكوارث القوية\", \"إدارة قواعد البيانات السحابية على AWS وAzure\" ] }, \"company_culture_mission_values\": { \"mission_statement\": null, \"core_values\": null, \"company_culture\": \"بيئة عمل ديناميكية مع فرص نمو مهني كبيرة\", \"market_position_achievements\": \"شركة تكنولوجيا رائدة\" } } }"}
{"provider":"openai","timestamp":1766470165313,"length":11063,"response":"{ \"en\": { \"description\": \"Company NXT LABS is a technology firm that specializes in high availability, disaster recovery, and cloud solutions. Founded in Rawalpindi, Pakistan, NXT LABS operates with a dynamic work environment that fosters professional growth. The company has a focus on managing and optimizing database systems, implementing robust disaster recovery solutions, and managing cloud databases on AWS and Azure. Currently, NXT LABS is dealing with an operational challenge concerning their database performance management. Due to rapid growth and increased data loads, the company is experiencing performance degradation and increased latency in their cloud database systems, impacting their system availability and throughput. The Senior Database Engineer: HA/DR & Cloud Solutions role is critical in addressing these challenges to ensure system reliability and performance metrics are met.\", \"instructions\": \"As the Senior Database Engineer: HA/DR & Cloud Solutions at NXT LABS, you are tasked with addressing the database performance and latency issues that have arisen due to increased data loads. Your specific objectives include optimizing MySQL and PostgreSQL databases, designing and implementing effective disaster recovery strategies, and improving cloud database management on AWS and Azure. Success will be measured by improved system reliability, reduced latency, and enhanced throughput. You must work within the constraints of existing infrastructure and limited budget, while collaborating with the development team to align database requirements with their sprints and CI/CD processes. Stakeholder expectations include a significant improvement in system availability and incident response time within the next quarter. Deliverables include a detailed report on performance enhancements and a revised disaster recovery plan.\", \"questions\": [ \"What specific database optimization techniques would you employ to address the performance degradation issues at NXT LABS?\", \"How would you prioritize the implementation of disaster recovery strategies given the current system availability metrics?\", \"What steps would you take to ensure data security and integrity while optimizing database performance?\", \"Describe how you would collaborate with the development team to align database optimizations with their sprints and CI/CD processes.\", \"How would you measure success in reducing latency and improving throughput on cloud databases managed on AWS and Azure?\", \"What resources would you require to effectively manage the database performance and what constraints might you encounter?\", \"How would you report on the improvements in system reliability and incident response time to meet stakeholder expectations?\" ], \"tables\": [ { \"table_id\": \"primary_metrics\", \"title\": \"Current Metrics & Performance\", \"description\": \"Key performance indicators for Senior Database Engineer: HA/DR & Cloud Solutions role\", \"columns\": [ {\"key\": \"metric_name\", \"label\": \"Metric\", \"type\": \"text\"}, {\"key\": \"current_value\", \"label\": \"Current Value\", \"type\": \"text\"}, {\"key\": \"target_value\", \"label\": \"Target\", \"type\": \"text\"}, {\"key\": \"variance\", \"label\": \"Variance\", \"type\": \"text\"}, {\"key\": \"trend\", \"label\": \"Trend\", \"type\": \"select\", \"options\": [\"↑ Improving\", \"→ Stable\", \"↓ Declining\"]} ], \"rows\": [ {\"metric_name\": \"Database Latency\", \"current_value\": \"200ms\", \"target_value\": \"100ms\", \"variance\": \"-50%\", \"trend\": \"↓ Declining\"}, {\"metric_name\": \"System Uptime\", \"current_value\": \"99.5%\", \"target_value\": \"99.9%\", \"variance\": \"-0.4%\", \"trend\": \"↑ Improving\"}, {\"metric_name\": \"Incident Response Time\", \"current_value\": \"30 minutes\", \"target_value\": \"15 minutes\", \"variance\": \"-50%\", \"trend\": \"→ Stable\"} ] }, { \"table_id\": \"scenario_data\", \"title\": \"Situation/Context Data\", \"description\": \"Contextual information relevant to the scenario\", \"columns\": [ {\"key\": \"item\", \"label\": \"Item\", \"type\": \"text\"}, {\"key\": \"status\", \"label\": \"Status\", \"type\": \"text\"}, {\"key\": \"impact\", \"label\": \"Impact Level\", \"type\": \"select\", \"options\": [\"Critical\", \"High\", \"Medium\", \"Low\"]}, {\"key\": \"notes\", \"label\": \"Details\", \"type\": \"text\"} ], \"rows\": [ {\"item\": \"Database Performance\", \"status\": \"Active\", \"impact\": \"High\", \"notes\": \"Current performance degradation impacting system throughput\"}, {\"item\": \"Disaster Recovery Plan\", \"status\": \"Pending\", \"impact\": \"Critical\", \"notes\": \"Need for updated recovery strategies to ensure data integrity and availability\"} ] }, { \"table_id\": \"resources_constraints\", \"title\": \"Available Resources & Constraints\", \"description\": \"What you have to work with and limitations\", \"columns\": [ {\"key\": \"resource_type\", \"label\": \"Resource Type\", \"type\": \"text\"}, {\"key\": \"availability\", \"label\": \"Availability\", \"type\": \"text\"}, {\"key\": \"cost_or_effort\", \"label\": \"Cost/Effort\", \"type\": \"text\"}, {\"key\": \"constraint\", \"label\": \"Constraint\", \"type\": \"text\"} ], \"rows\": [ {\"resource_type\": \"Cloud Infrastructure\", \"availability\": \"Fully available\", \"cost_or_effort\": \"Included in existing contracts\", \"constraint\": \"Time-bound\"}, {\"resource_type\": \"Database Optimization Tools\", \"availability\": \"Limited\", \"cost_or_effort\": \"Additional budget needed\", \"constraint\": \"Capacity limited\"} ] } ] }, \"ar\": { \"description\": \"شركة NXT LABS هي شركة تكنولوجيا متخصصة في التوافر العالي واستعادة الكوارث وحلول السحابة. تأسست في راولبندي، باكستان، وتعمل NXT LABS في بيئة عمل ديناميكية تشجع على النمو المهني. تركز الشركة على إدارة وتحسين أنظمة قواعد البيانات، وتنفيذ حلول استعادة الكوارث القوية، وإدارة قواعد البيانات السحابية على AWS وAzure. حاليًا، تواجه NXT LABS تحديًا تشغيليًا يتعلق بإدارة أداء قواعد البيانات. بسبب النمو السريع وزيادة الأحمال البيانية، تعاني الشركة من تدهور في الأداء وزيادة في التأخير في أنظمة قواعد البيانات السحابية، مما يؤثر على توافر النظام والإنتاجية. دور مهندس قواعد البيانات الرئيسي: HA/DR وحلول السحابة حاسم في معالجة هذه التحديات لضمان موثوقية النظام وتحقيق مقاييس الأداء.\", \"instructions\": \"بصفتك مهندس قواعد البيانات الرئيسي: HA/DR وحلول السحابة في NXT LABS، فإنك مكلف بمعالجة مشكلات أداء قواعد البيانات والتأخير التي نشأت بسبب زيادة الأحمال البيانية. تشمل أهدافك المحددة تحسين قواعد البيانات MySQL وPostgreSQL، وتصميم وتنفيذ استراتيجيات استعادة الكوارث الفعالة، وتحسين إدارة قواعد البيانات السحابية على AWS وAzure. سيتم قياس النجاح من خلال تحسين موثوقية النظام، وتقليل التأخير، وزيادة الإنتاجية. يجب أن تعمل ضمن قيود البنية التحتية الحالية والميزانية المحدودة، بينما تتعاون مع فريق التطوير لمواءمة متطلبات قواعد البيانات مع عمليات السبرينت وCI/CD الخاصة بهم. تشمل توقعات أصحاب المصلحة تحسينًا كبيرًا في توافر النظام ووقت الاستجابة للحوادث في الربع القادم. تشمل التسليمات تقريرًا مفصلاً عن تحسينات الأداء وخطة استعادة الكوارث المنقحة.\", \"questions\": [ \"ما التقنيات المحددة التي ستستخدمها لتحسين قواعد البيانات لمعالجة مشكلات تدهور الأداء في NXT LABS؟\", \"كيف ستعطي الأولوية لتنفيذ استراتيجيات استعادة الكوارث بالنظر إلى مقاييس توافر النظام الحالية؟\", \"ما الخطوات التي ستتخذها لضمان أمان البيانات وسلامتها أثناء تحسين أداء قواعد البيانات؟\", \"صف كيف ستتعاون مع فريق التطوير لمواءمة تحسينات قواعد البيانات مع عمليات السبرينت وCI/CD الخاصة بهم.\", \"كيف ستقيس النجاح في تقليل التأخير وتحسين الإنتاجية على قواعد البيانات السحابية التي تديرها على AWS وAzure؟\", \"ما الموارد التي ستحتاجها لإدارة أداء قواعد البيانات بفعالية وما القيود التي قد تواجهها؟\", \"كيف ستقدم تقريرًا عن التحسينات في موثوقية النظام ووقت الاستجابة للحوادث لتلبية توقعات أصحاب المصلحة؟\" ], \"tables\": [ { \"table_id\": \"primary_metrics\", \"title\": \"المقاييس الحالية والأداء\", \"description\": \"المؤشرات الرئيسية للأداء لدور مهندس قواعد البيانات الرئيسي: HA/DR وحلول السحابة\", \"columns\": [ {\"key\": \"metric_name\", \"label\": \"المؤشر\", \"type\": \"text\"}, {\"key\": \"current_value\", \"label\": \"القيمة الحالية\", \"type\": \"text\"}, {\"key\": \"target_value\", \"label\": \"الهدف\", \"type\": \"text\"}, {\"key\": \"variance\", \"label\": \"الفرق\", \"type\": \"text\"}, {\"key\": \"trend\", \"label\": \"الاتجاه\", \"type\": \"select\", \"options\": [\"↑ يتحسن\", \"→ مستقر\", \"↓ يتدهور\"]} ], \"rows\": [ {\"metric_name\": \"تأخير قاعدة البيانات\", \"current_value\": \"200ms\", \"target_value\": \"100ms\", \"variance\": \"-50%\", \"trend\": \"↓ يتدهور\"}, {\"metric_name\": \"توافر النظام\", \"current_value\": \"99.5%\", \"target_value\": \"99.9%\", \"variance\": \"-0.4%\", \"trend\": \"↑ يتحسن\"}, {\"metric_name\": \"وقت الاستجابة للحوادث\", \"current_value\": \"30 دقيقة\", \"target_value\": \"15 دقيقة\", \"variance\": \"-50%\", \"trend\": \"→ مستقر\"} ] }, { \"table_id\": \"scenario_data\", \"title\": \"بيانات الوضع / السياق\", \"description\": \"المعلومات السياقية ذات الصلة بالسيناريو\", \"columns\": [ {\"key\": \"item\", \"label\": \"البند\", \"type\": \"text\"}, {\"key\": \"status\", \"label\": \"الحالة\", \"type\": \"text\"}, {\"key\": \"impact\", \"label\": \"مستوى التأثير\", \"type\": \"select\", \"options\": [\"حرج\", \"عال\", \"متوسط\", \"منخفض\"]}, {\"key\": \"notes\", \"label\": \"التفاصيل\", \"type\": \"text\"} ], \"rows\": [ {\"item\": \"أداء قاعدة البيانات\", \"status\": \"نشط\", \"impact\": \"عال\", \"notes\": \"تدهور الأداء الحالي يؤثر على إنتاجية النظام\"}, {\"item\": \"خطة استعادة الكوارث\", \"status\": \"معلق\", \"impact\": \"حرج\", \"notes\": \"الحاجة إلى استراتيجيات استعادة محدثة لضمان سلامة وتوافر البيانات\"} ] }, { \"table_id\": \"resources_constraints\", \"title\": \"الموارد المتاحة والقيود\", \"description\": \"ما الذي لديك للعمل به والقيود\", \"columns\": [ {\"key\": \"resource_type\", \"label\": \"نوع المورد\", \"type\": \"text\"}, {\"key\": \"availability\", \"label\": \"التوافر\", \"type\": \"text\"}, {\"key\": \"cost_or_effort\", \"label\": \"التكلفة / الجهد\", \"type\": \"text\"}, {\"key\": \"constraint\", \"label\": \"القيود\", \"type\": \"text\"} ], \"rows\": [ {\"resource_type\": \"البنية التحتية السحابية\", \"availability\": \"متاح بالكامل\", \"cost_or_effort\": \"مدرجة في العقود الحالية\", \"constraint\": \"مقيد بالوقت\"}, {\"resource_type\": \"أدوات تحسين قواعد البيانات\", \"availability\": \"محدودة\", \"cost_or_effort\": \"تحتاج إلى ميزانية إضافية\", \"constraint\": \"سعة محدودة\"} ] } ] }, \"duration_minutes\": 60, \"case_study_type\": \"technical\", \"difficulty_level\": \"2\", \"num_questions\": \"300-500\", \"content_length\": \"\", \"variant_number\": 1, \"variant_focus\": \"operational_challenge\", \"job_title\": \"Senior Database Engineer: HA/DR & Cloud"}
