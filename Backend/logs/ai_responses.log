{"provider":"openai","timestamp":1767092052064,"length":3316,"response":"{ \"challenges\": [ { \"title_en\": \"Sum of Even Numbers\", \"title_ar\": \"مجموع الأعداد الزوجية\", \"problem_statement_en\": \"Write a function that takes a list of integers and returns the sum of all even numbers in the list.\", \"problem_statement_ar\": \"اكتب دالة تأخذ قائمة من الأعداد الصحيحة وتعيد مجموع جميع الأعداد الزوجية في القائمة.\", \"input_format_en\": \"A list of integers.\", \"input_format_ar\": \"قائمة من الأعداد الصحيحة.\", \"output_format_en\": \"An integer representing the sum of even numbers.\", \"output_format_ar\": \"عدد صحيح يمثل مجموع الأعداد الزوجية.\", \"constraints_en\": [\"The list will contain between 1 and 1000 elements.\", \"Each integer will be between -1000 and 1000.\"], \"constraints_ar\": [\"ستحتوي القائمة على ما بين 1 و 1000 عنصر.\", \"كل عدد صحيح سيكون بين -1000 و 1000.\"], \"examples\": [ { \"input\": \"[1, 2, 3, 4, 5, 6]\", \"output\": \"12\", \"explanation_en\": \"The even numbers are 2, 4, and 6. Their sum is 12.\", \"explanation_ar\": \"الأعداد الزوجية هي 2، 4، و6. مجموعها هو 12.\" } ], \"test_cases\": [ { \"input\": \"[1, 2, 3, 4, 5, 6]\", \"expected_output\": \"12\", \"is_hidden\": false }, { \"input\": \"[0, -2, 3, -4, 5]\", \"expected_output\": \"-6\", \"is_hidden\": true } ], \"starter_code\": { \"python\": \"def solution(numbers):\\n # Your code here\\n pass\", \"javascript\": \"function solution(numbers) {\\n // Your code here\\n}\", \"java\": \"public class Solution {\\n public static int solution(int[] numbers) {\\n // Your code here\\n return 0;\\n }\\n}\" }, \"difficulty\": \"easy\", \"tags\": [\"arrays\", \"numbers\", \"algorithms\"] }, { \"title_en\": \"Reverse a String\", \"title_ar\": \"عكس سلسلة\", \"problem_statement_en\": \"Write a function that takes a string and returns the string reversed.\", \"problem_statement_ar\": \"اكتب دالة تأخذ سلسلة وتعيد السلسلة معكوسة.\", \"input_format_en\": \"A string containing only printable ASCII characters.\", \"input_format_ar\": \"سلسلة تحتوي فقط على أحرف ASCII قابلة للطباعة.\", \"output_format_en\": \"A string that is the reverse of the input string.\", \"output_format_ar\": \"سلسلة هي عكس السلسلة المدخلة.\", \"constraints_en\": [\"The input string will have a length between 1 and 1000 characters.\"], \"constraints_ar\": [\"سيكون طول السلسلة المدخلة بين 1 و 1000 حرف.\"], \"examples\": [ { \"input\": \"\\\"hello\\\"\", \"output\": \"\\\"olleh\\\"\", \"explanation_en\": \"The reverse of 'hello' is 'olleh'.\", \"explanation_ar\": \"عكس 'hello' هو 'olleh'.\" } ], \"test_cases\": [ { \"input\": \"\\\"world\\\"\", \"expected_output\": \"\\\"dlrow\\\"\", \"is_hidden\": false }, { \"input\": \"\\\"racecar\\\"\", \"expected_output\": \"\\\"racecar\\\"\", \"is_hidden\": true } ], \"starter_code\": { \"python\": \"def solution(s):\\n # Your code here\\n pass\", \"javascript\": \"function solution(s) {\\n // Your code here\\n}\", \"java\": \"public class Solution {\\n public static String solution(String s) {\\n // Your code here\\n return \\\"\\\";\\n }\\n}\" }, \"difficulty\": \"easy\", \"tags\": [\"strings\", \"algorithms\", \"manipulation\"] } ] }"}
